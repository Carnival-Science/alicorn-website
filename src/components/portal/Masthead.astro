---
import { repository } from '../../data/site';
import { withBase } from '../../lib/paths';
const home = Astro.url.pathname.replace(/\/$/,'') === withBase('/').replace(/\/$/,'');
---
<header class="ex-header">
  <a class="ex-brand" href={withBase('/')} aria-label="Alicorn home">
    <img src={withBase('/favicon.svg')} alt="" width="37" height="37"/>Alicorn
  </a>
  <span class="brand-sub">Native GUI for Odin</span>
  <nav aria-label="Primary">
    <a href={withBase('/')} aria-current={home ? 'page' : undefined}>Home</a>
    <a href={withBase('/docs/')}>Docs</a>
    <a href={repository}>GitHub <span aria-hidden="true">↗</span></a>
  </nav>
</header>
