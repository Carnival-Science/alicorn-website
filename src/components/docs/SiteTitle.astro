---
import { withBase } from '../../lib/paths';
---

<a class="docs-wordmark" href={withBase('/')} aria-label="Alicorn home">
  <img src={withBase('/favicon.svg')} width="28" height="28" alt="" />
  <span>Alicorn</span>
  <b>DOCS</b>
</a>
<a class="docs-alikit-link" href={withBase('/components')}>Components</a>

<style>
  .docs-wordmark {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--sl-color-text);
    font: 800 1.1rem/1 var(--sl-font);
    letter-spacing: -0.04em;
    text-decoration: none;
    white-space: nowrap;
  }

  .docs-wordmark img { width: 1.65rem; height: 1.65rem; }
  :global([data-theme="dark"]) .docs-wordmark img { filter: brightness(1.8); }

  .docs-wordmark b {
    padding: 0.22rem 0.38rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 3px;
    color: var(--sl-color-gray-3);
    font: 700 0.58rem/1 var(--sl-font-mono);
    letter-spacing: 0.08em;
  }

  .docs-alikit-link {
    margin-left: 0.2rem;
    color: var(--sl-color-text-accent);
    font: 700 0.78rem/1 var(--sl-font-mono);
    text-decoration: none;
  }

  .docs-alikit-link:hover { text-decoration: underline; }

  @media (max-width: 50rem) {
    .docs-wordmark b { display: none; }
  }
</style>
