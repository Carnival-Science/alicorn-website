---
/**
 * A live AliKit component example compiled to WebAssembly and drawn with
 * Alicorn's WebGPU renderer (see src/lib/alicorn-embed.ts).
 */
interface Props {
  /** Catalog slug of the demo. */
  id: string;
  /** Height of the demo area in pixels. */
  height?: number;
}

const { id, height = 440 } = Astro.props;
---
<figure class="demo" data-demo-root={id} style={'--demo-height:' + height + 'px'}>
  <div class="demo-frame">
    <canvas class="demo-canvas" data-demo-canvas hidden aria-label={'Live ' + id + ' demo'}></canvas>
    <div class="demo-fallback" data-demo-fallback hidden role="status">
      Live preview requires a secure browser context with WebGPU support.
    </div>
  </div>
  <figcaption class="demo-meta">
    <span class="demo-lamp" data-demo-lamp aria-hidden="true"></span>
    <span class="demo-label">Live WebGPU preview</span>
    <span class="demo-status" aria-live="polite" data-demo-status>waiting</span>
    <span class="demo-hint">Click the preview, then use Tab and the arrow keys.</span>
  </figcaption>
</figure>

<script>
  import { startEmbed, webgpuAvailable } from '../lib/alicorn-embed';

  const root = document.querySelector<HTMLElement>('[data-demo-root]');
  if (root) {
    const id = root.dataset.demoRoot!;
    const canvas = root.querySelector<HTMLCanvasElement>('[data-demo-canvas]')!;
    const fallback = root.querySelector<HTMLElement>('[data-demo-fallback]')!;
    const lamp = root.querySelector<HTMLElement>('[data-demo-lamp]')!;
    const statusEl = root.querySelector<HTMLElement>('[data-demo-status]')!;
    const status = (text: string) => {
      statusEl.textContent = text;
      if (text === 'running') {
        fallback.hidden = true;
        lamp.dataset.state = 'live';
      }
    };
    const fail = (text: string) => {
      canvas.hidden = true;
      fallback.hidden = false;
      lamp.dataset.state = 'error';
      status(text);
    };

    const run = async () => {
      if (!(await webgpuAvailable())) {
        lamp.dataset.state = 'off';
        fallback.hidden = false;
        status(isSecureContext ? 'WebGPU unavailable' : 'secure context required');
        return;
      }
      const controller = new AbortController();
      addEventListener('pagehide', () => controller.abort(), { once: true });
      try {
        canvas.hidden = false;
        await startEmbed({ demo: id, canvas, signal: controller.signal, status, error: fail });
      } catch (error) {
        canvas.hidden = true;
        fallback.hidden = false;
        fail('failed: ' + (error instanceof Error ? error.message : 'unknown'));
      }
    };

    if (root.getBoundingClientRect().top < innerHeight * 1.5) {
      void run();
    } else {
      status('scroll to start');
      const observer = new IntersectionObserver((entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        observer.disconnect();
        void run();
      }, { rootMargin: '200px' });
      observer.observe(root);
    }
  }
</script>

<style>
  .demo { margin: 1.25rem 0 1.75rem; }
  .demo-frame {
    position: relative;
    height: var(--demo-height);
    border: 1px solid var(--sl-color-hairline);
    border-radius: 6px;
    background: #10151b;
    overflow: hidden;
  }
  .demo-canvas {
    display: block;
    width: 100%;
    height: 100%;
    outline: none;
  }
  .demo-canvas:focus-visible { box-shadow: inset 0 0 0 2px var(--sl-color-accent); }
  .demo-fallback {
    display: grid;
    width: 100%;
    height: 100%;
    place-items: center;
    padding: 1.5rem;
    color: var(--sl-color-gray-3);
    text-align: center;
  }
  .demo-fallback[hidden] { display: none; }
  .demo-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.9rem;
    margin-top: 0.55rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
  .demo-label { color: var(--sl-color-gray-2); }
  .demo-status { flex: 1; min-width: 0; font-family: var(--sl-font-mono); }
  .demo-lamp {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--sl-color-gray-4);
  }
  .demo-lamp[data-state='live'] { background: #3fb67a; }
  .demo-lamp[data-state='error'] { background: #d2483f; }
  .demo-hint { display: none; }
  @media (min-width: 50rem) { .demo-hint { display: inline; } }
</style>
